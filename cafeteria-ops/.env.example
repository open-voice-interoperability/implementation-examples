# Cafeteria Ops Floor — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# LLM Configuration (required for all agents)
# ---------------------------------------------------------------------------

# OpenAI (default)
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Ollama (local, no key needed)
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# Smaller/faster model for the convener's routing/intent classification step
# only (which agents should answer, is this an invite-only instruction,
# etc.) -- a narrow decision that doesn't need the main model's depth and
# falls back to a regex classifier on any failure. Leave unset to use the
# defaults below; only override if you want something different.
# CLASSIFIER_LLM_MODEL=gpt-4.1-nano       # OpenAI-compatible provider (default: gpt-4.1-nano)
# CLASSIFIER_OLLAMA_MODEL=llama3.2:1b     # Ollama provider (default: same as OLLAMA_MODEL, i.e. no smaller model unless set)

# ---------------------------------------------------------------------------
# Free API keys (optional — public APIs work without keys but have rate limits)
# ---------------------------------------------------------------------------

# USDA FoodData Central (nutrition) — free at fdc.nal.usda.gov/api-key-signup
# Falls back to the shared DEMO_KEY (30 req/hr) if left unset; a real key
# raises that to ~1000 req/hr.
FDC_API_KEY=DEMO_KEY

# USDA AMS MARS / My Market News API (wholesale commodity pricing) — free
# registration at mymarketnews.ams.usda.gov/mars-api/getting-started.
# REQUIRED: unlike FoodData Central's DEMO_KEY, there is no anonymous
# fallback -- requests without a key get a 401 (confirmed via testing).
AMS_API_KEY=

# TheMealDB (recipe ideas) — the shared test key "1" works immediately with
# no signup for non-commercial/prototype use; only change this if you have
# your own key (e.g. via Patreon for higher limits/commercial use).
THEMEALDB_API_KEY=1

# Tavily (web search) — used by the Procurement Specialist to find current
# retail/grocery prices for ingredients USDA AMS's wholesale commodity
# reports don't cover (e.g. quinoa, shrimp, soy sauce). Free tier: 1,000
# searches/month, no credit card required. Get a key at tavily.com --
# chosen over Brave Search (free tier now requires a card on file) and
# Google Custom Search (closed to new signups as of 2025). Procurement
# falls back to general guidance, honestly labeled as such, if left unset.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Image generation (optional — used by the Menu Designer to illustrate each
# proposed meal; a line with no image just shows text if left unconfigured)
# ---------------------------------------------------------------------------

# Hugging Face Inference Providers — free tier, get a token at
# huggingface.co/settings/tokens (needs "Make calls to Inference Providers"
# permission). Tried first when set; falls back to OpenAI below on failure.
HF_API_KEY=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Which image provider(s) to use, and in what order: 'auto' (Hugging Face
# first if HF_API_KEY is set, then OpenAI), 'huggingface', or 'openai'.
IMAGE_PROVIDER=auto

# ---------------------------------------------------------------------------
# Service URLs (override for hosted deployments)
# ---------------------------------------------------------------------------

# CONVENER_SERVICE_URL=https://your-convener.example.com/
# MENU_DESIGNER_SERVICE_URL=http://127.0.0.1:8301/
# NUTRITION_SERVICE_URL=http://127.0.0.1:8302/
# RECIPE_PORTION_SERVICE_URL=http://127.0.0.1:8303/
# MENU_OPTIMIZATION_SERVICE_URL=http://127.0.0.1:8304/
# INVENTORY_SERVICE_URL=http://127.0.0.1:8305/
# PROCUREMENT_SERVICE_URL=http://127.0.0.1:8306/
# SUPPLIER_SERVICE_URL=http://127.0.0.1:8307/
# RECEIVING_STORAGE_SERVICE_URL=http://127.0.0.1:8308/
# SUPPLY_OPTIMIZATION_SERVICE_URL=http://127.0.0.1:8309/
