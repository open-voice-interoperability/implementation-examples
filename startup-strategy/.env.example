# Startup Strategy Floor — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# LLM Configuration (required for all agents)
# ---------------------------------------------------------------------------

# OpenAI (default)
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Ollama (local, no key needed)
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Free API keys (optional — public APIs work without keys but have rate limits)
# ---------------------------------------------------------------------------

# FRED (Federal Reserve Economic Data) — free at fred.stlouisfed.org
FRED_API_KEY=

# BLS (Bureau of Labor Statistics) — free at data.bls.gov/registrationEngine
BLS_API_KEY=

# ---------------------------------------------------------------------------
# Service URLs (override for hosted deployments)
# ---------------------------------------------------------------------------

# CONVENER_SERVICE_URL=https://your-convener.example.com/
# MARKET_SERVICE_URL=http://localhost:8200/
# COMPETITIVE_SERVICE_URL=http://localhost:8201/
# MODEL_SERVICE_URL=http://localhost:8202/
# RISK_SERVICE_URL=http://localhost:8203/
# FUNDING_SERVICE_URL=http://localhost:8204/
# WORKFORCE_SERVICE_URL=http://localhost:8205/
# SKEPTIC_SERVICE_URL=http://localhost:8206/
# STRATEGY_SERVICE_URL=http://localhost:8207/
